---
interface Props {
	number: string;
	title: string;
	description: string;
	href: string;
	chips?: string[];
}
const { number, title, description, href, chips = [] } = Astro.props;
---

<a class="project-card" href={href}>
	<span class="project-number">{number}</span>
	<span class="project-body">
		<span class="project-title">{title}</span>
		<span class="project-description">{description}</span>
		{chips.length > 0 && (
			<span class="chip-list">
				{chips.map((chip) => <span class="chip">{chip}</span>)}
			</span>
		)}
	</span>
	<span class="project-arrow" aria-hidden="true">↗</span>
</a>

<style>
	.project-card {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) auto;
		gap: 24px;
		align-items: start;
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
	}
	.project-card:hover .project-title { text-decoration: underline; text-decoration-color: var(--accent-deep); text-underline-offset: 5px; }
	.project-card:hover .project-arrow { transform: translate(2px, -2px); }
	.project-number { padding-top: 6px; color: var(--muted); font: 500 11px var(--font-mono); }
	.project-body { display: grid; gap: 8px; }
	.project-title { font-size: 22px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; }
	.project-description { color: var(--ink-soft); font-size: 15px; line-height: 1.5; }
	.project-body .chip-list { margin-top: 4px; }
	.project-arrow { padding-top: 2px; font-size: 20px; transition: transform 0.15s; }
	@media (max-width: 640px) {
		.project-card { grid-template-columns: 36px minmax(0, 1fr) 20px; gap: 12px; padding: 22px 0; }
		.project-title { font-size: 19px; }
	}
</style>
