---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div>
		<p class="footer-name">{site.name}</p>
		<p class="footer-role">{site.role} · {site.summary}</p>
	</div>
	<ul class="footer-links">
		<li><a href={site.github} rel="me noopener noreferrer" target="_blank">GitHub<span aria-hidden="true"> ↗</span></a></li>
		{site.linkedin && <li><a href={site.linkedin} rel="me noopener noreferrer" target="_blank">LinkedIn<span aria-hidden="true"> ↗</span></a></li>}
		{site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
		{site.resume && <li><a href={site.resume} target="_blank" rel="noopener noreferrer">Résumé (PDF)</a></li>}
	</ul>
	<p class="footer-copy">© {year} {site.name}</p>
</footer>

<style>
	.site-footer {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 16px 40px;
		align-items: start;
		padding: 32px 0 40px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 13px;
	}
	.footer-name { margin: 0 0 4px; color: var(--ink); font-weight: 700; }
	.footer-role { margin: 0; }
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0;
		padding: 0;
		list-style: none;
		font: 500 12px var(--font-mono);
	}
	.footer-links a { color: var(--ink); text-decoration: none; }
	.footer-links a:hover { text-decoration: underline; }
	.footer-copy { grid-column: 1 / -1; margin: 0; font: 11px var(--font-mono); }
	@media (max-width: 640px) {
		.site-footer { grid-template-columns: 1fr; }
	}
</style>
