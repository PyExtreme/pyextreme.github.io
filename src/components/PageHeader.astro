---
interface Props {
	eyebrow: string;
	title: string;
}
const { eyebrow, title } = Astro.props;
---

<header class="page-header">
	<p class="eyebrow">{eyebrow}</p>
	<h1 class="display-1">{title}</h1>
	<div class="page-intro"><slot /></div>
</header>

<style>
	.page-header { max-width: 720px; margin-bottom: 56px; }
	.page-intro :global(p) { max-width: 560px; margin: 0; color: var(--ink-soft); font-size: 17px; line-height: 1.65; }
	@media (max-width: 640px) { .page-header { margin-bottom: 40px; } }
</style>
