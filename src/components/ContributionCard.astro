---
import type { CollectionEntry } from 'astro:content';
import StatusPill from './StatusPill.astro';

interface Props {
	contribution: CollectionEntry<'contributions'>;
}
const { contribution } = Astro.props;
const d = contribution.data;
const status = d.prMerged ? 'Merged' : d.status;
const href = `/open-source/${contribution.id}/`;
const date = new Date(`${d.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="contribution" data-date={d.date} data-complexity={d.complexity} data-status={status}>
	<div class="contribution-main">
		<p class="contribution-repo">
			<a href={d.repositoryUrl}>{d.repository}</a>
			<span class="contribution-ref">· {d.issueNumber} · <time datetime={d.date}>{date}</time></span>
		</p>
		<h3 class="contribution-title"><a href={href}>{d.title}</a></h3>
		<p class="contribution-summary">{d.shortSummary}</p>
		<ul class="chip-list">
			{d.concepts.map((concept) => <li class="chip">{concept}</li>)}
		</ul>
	</div>
	<div class="contribution-side">
		<StatusPill status={status} />
		<p class="contribution-meta">{d.complexity} · {d.technicalArea}</p>
		<p class="contribution-links">
			<a href={href}>Write-up</a>
			{d.prUrl && <a href={d.prUrl}>PR<span aria-hidden="true"> ↗</span></a>}
			{d.issueUrl && <a href={d.issueUrl}>Issue<span aria-hidden="true"> ↗</span></a>}
			{d.commitUrl && <a href={d.commitUrl}>Commit<span aria-hidden="true"> ↗</span></a>}
		</p>
	</div>
</article>

<style>
	.contribution {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 240px;
		gap: 24px 48px;
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
	}
	.contribution[hidden] { display: none; }
	.contribution-repo { margin: 0 0 10px; font: 500 12px var(--font-mono); }
	.contribution-repo a { color: var(--ink); text-decoration: none; }
	.contribution-repo a:hover { text-decoration: underline; }
	.contribution-ref { color: var(--muted); }
	.contribution-title { margin: 0 0 10px; font-size: 22px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; }
	.contribution-title a { text-decoration: none; }
	.contribution-title a:hover { text-decoration: underline; text-decoration-color: var(--accent-deep); text-underline-offset: 5px; }
	.contribution-summary { max-width: 62ch; margin: 0 0 14px; color: var(--ink-soft); font-size: 15px; line-height: 1.55; }
	.contribution-side { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding-top: 2px; }
	.contribution-meta { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
	.contribution-links { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; font: 500 12px var(--font-mono); }
	.contribution-links a { color: var(--ink); }
	@media (max-width: 760px) {
		.contribution { grid-template-columns: 1fr; gap: 16px; }
		.contribution-side { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
		.contribution-meta { flex-basis: 100%; }
	}
</style>
