---
const scenes = [
	{
		title: 'Form hypotheses',
		dur: 6000,
		calc: 'prior: gateway 0.40, inference 0.35, index 0.10, other 0.15',
		text: 'The engine forms hypotheses from the anomaly digest. Each starts with a prior proportional to its anomaly score. An "other" bucket (0.15) captures unlisted causes but is excluded from information-gain calculations.',
	},
	{
		title: 'Design a discriminating test',
		dur: 7000,
		calc: 'best test: onset_order(gateway, inference) → gain 0.42 bits',
		text: 'The engine designs tests that maximally discriminate between hypotheses, scoring each by expected information gain over a 0.05-bit threshold. It predicts each outcome before running the tool.',
	},
	{
		title: 'Predict, then observe',
		dur: 7000,
		calc: 'predict: gateway-first if root=gateway (0.85) | observe: gateway Δt = −2.3 s ✓',
		text: 'Predictions are written before the tool runs. The observation confirms the gateway-first prediction. The Bayesian update shifts belief toward gateway-overload.',
	},
	{
		title: 'Belief update',
		dur: 7000,
		calc: 'posterior: gateway 0.72 ↑  inference 0.18 ↓ | threshold: 0.80, need 1 more test',
		text: 'One confirming predicate moves belief to 0.72, below the 0.80 stop threshold. The engine needs at least one test and top belief ≥ 0.80 to declare confident. It designs another test.',
	},
	{
		title: 'Confident diagnosis',
		dur: 8000,
		calc: '2 tests, 2 confirmed → gateway 0.87 ≥ 0.80 → CONFIDENT | cost: $0.007',
		text: 'Two confirming predicates reach 0.87 and stop. The engine identifies both the root service and the fault type. At $0.007 per incident, it is the cheapest arm — and when it answers at belief ≥ 0.80, it is right 88.5% of the time.',
	},
];
const total = Math.round(scenes.reduce((sum, s) => sum + s.dur, 0) / 1000);
---

<figure class="ce theme-light" data-explainer-ce data-scene="1">
	<figcaption class="ce-head">
		<span class="ce-eyebrow">Animated explainer · {scenes.length} scenes · {total} s</span>
		<span class="ce-now" aria-hidden="true"></span>
	</figcaption>

	<svg class="ce-stage" viewBox="0 0 760 340" role="img" aria-label="Causal engine: Bayesian belief bar updates as the engine runs discriminating tests, predicts outcomes, and converges on a confident diagnosis.">
		<defs>
			<linearGradient id="ce-gw" x1="0" x2="1"><stop offset="0%" stop-color="#8fae1c"/><stop offset="100%" stop-color="#a5c430"/></linearGradient>
			<linearGradient id="ce-inf" x1="0" x2="1"><stop offset="0%" stop-color="#2d8a7e"/><stop offset="100%" stop-color="#3ca898"/></linearGradient>
			<linearGradient id="ce-idx" x1="0" x2="1"><stop offset="0%" stop-color="#b4bdb8"/><stop offset="100%" stop-color="#c8d0cc"/></linearGradient>
			<linearGradient id="ce-oth" x1="0" x2="1"><stop offset="0%" stop-color="#d9dfdc"/><stop offset="100%" stop-color="#e6ebe8"/></linearGradient>
		</defs>

		<!-- Belief bar background -->
		<rect class="bb-bg" x="60" y="20" width="640" height="32" rx="4" fill="var(--paper-2)" stroke="var(--line)" stroke-width="1"/>

		<!-- Belief bar: scene 1 (prior) -->
		<g class="bb bb-s1">
			<rect class="bb-gw" x="60" y="20" width="256" height="32" rx="4" fill="url(#ce-gw)"/>
			<rect class="bb-inf" x="316" y="20" width="224" height="32" fill="url(#ce-inf)"/>
			<rect class="bb-idx" x="540" y="20" width="64" height="32" fill="url(#ce-idx)"/>
			<rect class="bb-oth" x="604" y="20" width="96" height="32" rx="0" fill="url(#ce-oth)"/>
			<text class="bb-label" x="188" y="40" fill="#fff">gateway 0.40</text>
			<text class="bb-label" x="428" y="40" fill="#fff">inference 0.35</text>
			<text class="bb-label bb-sm" x="572" y="40" fill="var(--ink-soft)">0.10</text>
			<text class="bb-label bb-sm" x="652" y="40" fill="var(--muted)">0.15</text>
		</g>

		<!-- Belief bar: scene 3-4 (after test 1) -->
		<g class="bb bb-s34">
			<rect x="60" y="20" width="461" height="32" rx="4" fill="url(#ce-gw)"/>
			<rect x="521" y="20" width="115" height="32" fill="url(#ce-inf)"/>
			<rect x="636" y="20" width="38" height="32" fill="url(#ce-idx)"/>
			<rect x="674" y="20" width="26" height="32" rx="0" fill="url(#ce-oth)"/>
			<text class="bb-label" x="290" y="40" fill="#fff">gateway 0.72 ↑</text>
			<text class="bb-label bb-sm" x="578" y="40" fill="#fff">0.18</text>
		</g>

		<!-- Belief bar: scene 5 (after test 2) -->
		<g class="bb bb-s5">
			<rect x="60" y="20" width="557" height="32" rx="4" fill="url(#ce-gw)"/>
			<rect x="617" y="20" width="58" height="32" fill="url(#ce-inf)"/>
			<rect x="675" y="20" width="25" height="32" rx="0" fill="url(#ce-idx)"/>
			<text class="bb-label" x="338" y="40" fill="#fff" font-weight="700">gateway 0.87 — CONFIDENT</text>
		</g>

		<!-- Threshold line at 0.80 -->
		<line class="threshold" x1="572" y1="16" x2="572" y2="56" stroke="#b8402a" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.5"/>
		<text class="threshold-label" x="576" y="12" fill="#b8402a" font-size="10" opacity="0.6">0.80</text>

		<!-- Hypothesis table -->
		<g class="hyp-table">
			<text class="ht-header" x="60" y="82">Hypotheses</text>
			<g class="hyp h-gw">
				<rect x="60" y="90" width="300" height="28" rx="3" fill="var(--paper-2)" stroke="var(--accent-deep)" stroke-width="1"/>
				<text x="72" y="109" fill="var(--ink)" font-size="12" font-weight="600">gateway-overload</text>
				<text class="hyp-prior" x="348" y="109" fill="var(--accent-deep)" font-size="12" text-anchor="end">0.40</text>
			</g>
			<g class="hyp h-inf">
				<rect x="60" y="124" width="300" height="28" rx="3" fill="var(--paper-2)" stroke="var(--line-strong)" stroke-width="1"/>
				<text x="72" y="143" fill="var(--ink)" font-size="12">inference-oom</text>
				<text class="hyp-prior" x="348" y="143" fill="var(--ink-soft)" font-size="12" text-anchor="end">0.35</text>
			</g>
			<g class="hyp h-idx">
				<rect x="60" y="158" width="300" height="28" rx="3" fill="var(--paper-2)" stroke="var(--line)" stroke-width="1"/>
				<text x="72" y="177" fill="var(--muted)" font-size="12">index-degraded</text>
				<text class="hyp-prior" x="348" y="177" fill="var(--muted)" font-size="12" text-anchor="end">0.10</text>
			</g>
			<g class="hyp h-oth" opacity="0.4">
				<rect x="60" y="192" width="300" height="28" rx="3" fill="var(--paper-2)" stroke="var(--line)" stroke-width="1" stroke-dasharray="4 3"/>
				<text x="72" y="211" fill="var(--muted)" font-size="12" font-style="italic">other</text>
				<text x="348" y="211" fill="var(--muted)" font-size="12" text-anchor="end">0.15</text>
			</g>
		</g>

		<!-- Test design area -->
		<g class="test-area">
			<text class="ta-header" x="400" y="82">Test design</text>
			<g class="test-card tc1">
				<rect x="400" y="90" width="340" height="52" rx="4" fill="var(--paper-2)" stroke="var(--accent-deep)" stroke-width="1.5"/>
				<text x="412" y="110" fill="var(--ink)" font-size="12" font-weight="600">onset_order(gateway, inference)</text>
				<text x="412" y="128" fill="var(--accent-deep)" font-size="11">info gain: 0.42 bits ← selected</text>
			</g>
			<g class="test-card tc2">
				<rect x="400" y="150" width="340" height="34" rx="4" fill="var(--paper-2)" stroke="var(--line)" stroke-width="1"/>
				<text x="412" y="172" fill="var(--muted)" font-size="11">metric_change(inference, cpu) → 0.18 bits</text>
			</g>
			<g class="test-card tc3">
				<rect x="400" y="190" width="340" height="34" rx="4" fill="var(--paper-2)" stroke="var(--line)" stroke-width="1"/>
				<text x="412" y="212" fill="var(--muted)" font-size="11">flow_ratio(gateway, inference) → 0.12 bits</text>
			</g>
		</g>

		<!-- Prediction and observation boxes -->
		<g class="predict-box">
			<rect x="400" y="90" width="340" height="60" rx="4" fill="var(--paper-2)" stroke="var(--accent-deep)" stroke-width="1.5"/>
			<text x="412" y="110" fill="var(--muted)" font-size="10" text-transform="uppercase" letter-spacing="0.06em">Prediction (journaled before tool runs)</text>
			<text x="412" y="130" fill="var(--ink)" font-size="13" font-weight="600">if root=gateway → gateway onset first (p=0.85)</text>
			<text x="412" y="148" fill="var(--ink-soft)" font-size="12">if root=inference → inference onset first (p=0.90)</text>
		</g>
		<g class="observe-box">
			<rect x="400" y="160" width="340" height="44" rx="4" fill="var(--accent)" stroke="var(--accent-deep)" stroke-width="1.5"/>
			<text x="412" y="180" fill="var(--on-accent)" font-size="10" text-transform="uppercase" letter-spacing="0.06em">Observation</text>
			<text x="412" y="196" fill="var(--on-accent)" font-size="13" font-weight="700">gateway onset 2.3 s before inference ✓</text>
		</g>

		<!-- Confident badge -->
		<g class="confident-badge">
			<rect x="400" y="90" width="340" height="130" rx="6" fill="var(--accent)" stroke="var(--accent-deep)" stroke-width="2"/>
			<text x="570" y="125" fill="var(--on-accent)" font-size="11" text-anchor="middle" text-transform="uppercase" letter-spacing="0.08em" font-weight="500">Diagnosis</text>
			<text x="570" y="155" fill="var(--on-accent)" font-size="20" text-anchor="middle" font-weight="700">gateway-overload</text>
			<text x="570" y="178" fill="var(--on-accent)" font-size="14" text-anchor="middle">(retry-storm)</text>
			<text x="570" y="206" fill="var(--on-accent)" font-size="12" text-anchor="middle" opacity="0.8">2 tests · belief 0.87 · $0.007</text>
		</g>

		<!-- Below threshold indicator -->
		<g class="below-thresh">
			<rect x="400" y="250" width="340" height="30" rx="4" fill="none" stroke="#b8402a" stroke-width="1" stroke-dasharray="4 3"/>
			<text x="570" y="270" fill="#b8402a" font-size="11" text-anchor="middle">belief 0.72 &lt; threshold 0.80 — designing next test</text>
		</g>
	</svg>

	<ol class="ce-steps">
		{scenes.map((scene, i) => (
			<li data-step={i + 1} data-dur={scene.dur} data-title={scene.title}>
				<code class="ce-calc">{scene.calc}</code>
				<p class="ce-text"><strong>{scene.title}.</strong> {scene.text}</p>
			</li>
		))}
	</ol>

	<div class="ce-controls" hidden>
		<button type="button" class="ce-btn" data-act="prev" aria-label="Previous scene">←</button>
		<button type="button" class="ce-btn ce-play" data-act="play">Play</button>
		<button type="button" class="ce-btn" data-act="next" aria-label="Next scene">→</button>
		<div class="ce-segs">
			{scenes.map((scene, i) => (
				<button type="button" class="ce-seg" data-go={i} aria-label={`Scene ${i + 1}: ${scene.title}`}><span></span></button>
			))}
		</div>
	</div>
</figure>

<style>
	.ce {
		margin: 2.4em 0;
		padding: 20px 20px 16px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: #fff;
	}
	.ce-head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; font: 500 11px/1.5 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
	.ce-eyebrow { color: var(--muted); }
	.ce-now { color: var(--ink); text-align: right; }
	.ce-stage { display: block; width: 100%; height: auto; font-family: var(--font-mono); }

	/* Belief bar segments */
	.bb { transition: opacity 0.6s; }
	.bb-label { font-size: 12px; font-weight: 600; text-anchor: middle; }
	.bb-sm { font-size: 10px; }
	.bb-s1, .bb-s34, .bb-s5 { opacity: 0; }

	[data-scene='1'] .bb-s1,
	[data-scene='2'] .bb-s1 { opacity: 1; }
	[data-scene='3'] .bb-s34,
	[data-scene='4'] .bb-s34 { opacity: 1; }
	[data-scene='5'] .bb-s5 { opacity: 1; }

	/* Hypothesis table */
	.hyp-table { opacity: 0; transition: opacity 0.5s; }
	[data-scene='1'] .hyp-table { opacity: 1; }
	[data-scene='2'] .hyp-table { opacity: 1; }
	[data-scene='3'] .hyp-table { opacity: 0.4; }
	[data-scene='4'] .hyp-table { opacity: 0.4; }
	[data-scene='5'] .hyp-table { opacity: 0.3; }
	.ht-header { fill: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; }
	.hyp { transition: opacity 0.4s; }
	[data-scene='1'] .h-gw { animation: ce-slideIn 0.4s 0.3s ease-out both; }
	[data-scene='1'] .h-inf { animation: ce-slideIn 0.4s 0.5s ease-out both; }
	[data-scene='1'] .h-idx { animation: ce-slideIn 0.4s 0.7s ease-out both; }
	[data-scene='1'] .h-oth { animation: ce-slideIn 0.4s 0.9s ease-out both; }

	/* Test area */
	.test-area { opacity: 0; transition: opacity 0.5s; }
	.ta-header { fill: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; }
	[data-scene='2'] .test-area { opacity: 1; }
	[data-scene='2'] .tc1 { animation: ce-slideIn 0.3s 0.4s ease-out both; }
	[data-scene='2'] .tc2 { animation: ce-slideIn 0.3s 0.6s ease-out both; }
	[data-scene='2'] .tc3 { animation: ce-slideIn 0.3s 0.8s ease-out both; }

	/* Prediction + observation */
	.predict-box, .observe-box { opacity: 0; transition: opacity 0.5s; }
	[data-scene='3'] .predict-box { opacity: 1; transition-delay: 0.3s; }
	[data-scene='3'] .observe-box { opacity: 1; transition-delay: 1.5s; }

	/* Below threshold */
	.below-thresh { opacity: 0; transition: opacity 0.5s; }
	[data-scene='4'] .below-thresh { opacity: 1; transition-delay: 0.5s; }
	[data-scene='4'] .hyp-table { opacity: 0.4; }

	/* Confident badge */
	.confident-badge { opacity: 0; transition: opacity 0.5s; }
	[data-scene='5'] .confident-badge { opacity: 1; transition-delay: 0.6s; }
	[data-scene='5'] .h-gw rect { stroke: var(--accent-deep); stroke-width: 2; fill: var(--accent); }

	/* Threshold line */
	.threshold { transition: opacity 0.4s; }
	[data-scene='4'] .threshold { opacity: 1; }
	[data-scene='5'] .threshold { opacity: 0.3; }

	@keyframes ce-slideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

	.ce-steps { margin: 16px 0 0; padding: 0; list-style: none; }
	.ce-steps li { margin: 0 0 14px; }
	.ce-calc {
		display: block;
		padding: 8px 12px;
		border-radius: 6px;
		background: var(--paper-2);
		color: var(--ink);
		font: 13px/1.55 var(--font-mono);
		overflow-wrap: anywhere;
	}
	.ce-text { margin: 10px 0 0; font-size: 15.5px; line-height: 1.6; }
	.ce.is-js .ce-steps li { min-height: 8.5em; margin: 0; }

	.ce-controls { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
	.ce-controls[hidden] { display: none; }
	.ce-btn {
		min-width: 40px; height: 34px; padding: 0 12px;
		border: 1px solid var(--line-strong); border-radius: 999px;
		background: var(--paper); color: var(--ink);
		font: 500 12px/1 var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer;
	}
	.ce-btn:hover { border-color: var(--ink); }
	.ce-btn:disabled { opacity: 0.4; cursor: default; }
	.ce-play { min-width: 76px; background: var(--ink); border-color: var(--ink); color: var(--paper); }
	.ce-segs { display: flex; flex: 1; gap: 4px; margin-left: 6px; }
	.ce-seg { flex: 1; height: 34px; padding: 0; border: 0; background: none; cursor: pointer; }
	.ce-seg span { position: relative; display: block; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
	.ce-seg span::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform: scaleX(var(--p, 0)); transform-origin: left; }

	@media (max-width: 640px) {
		.ce { padding: 14px 12px 12px; }
		.ce-head { flex-direction: column; gap: 0; }
		.ce-now { text-align: left; }
		.ce.is-js .ce-steps li { min-height: 13.5em; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ce *, .ce *::after { animation-duration: 1ms !important; animation-delay: 0s !important; transition-duration: 1ms !important; transition-delay: 0s !important; }
	}
</style>

<script>
	for (const fig of document.querySelectorAll<HTMLElement>('[data-explainer-ce]')) {
		const steps = [...fig.querySelectorAll<HTMLLIElement>('[data-step]')];
		const segs = [...fig.querySelectorAll<HTMLButtonElement>('.ce-seg')];
		const controls = fig.querySelector<HTMLElement>('.ce-controls')!;
		const play = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		const prev = fig.querySelector<HTMLButtonElement>('[data-act="prev"]')!;
		const next = fig.querySelector<HTMLButtonElement>('[data-act="next"]')!;
		const now = fig.querySelector<HTMLElement>('.ce-now')!;
		const durs = steps.map((s) => Number(s.dataset.dur));
		const last = steps.length - 1;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		let current = 0;
		let playing = false;
		let ended = false;
		let touched = false;
		let elapsed = 0;
		let start = 0;
		let frame = 0;

		const show = (n: number) => {
			current = n;
			elapsed = 0;
			start = performance.now();
			ended = false;
			fig.dataset.scene = String(n + 1);
			steps.forEach((s, i) => (s.hidden = i !== n));
			segs.forEach((s, i) => {
				s.style.setProperty('--p', i < n ? '1' : '0');
				if (i === n) s.setAttribute('aria-current', 'step');
				else s.removeAttribute('aria-current');
			});
			now.textContent = `${n + 1} / ${steps.length} · ${steps[n].dataset.title}`;
			prev.disabled = n === 0;
			next.disabled = n === last;
			if (!playing) play.textContent = 'Play';
		};

		const tick = (t: number) => {
			if (!playing) return;
			elapsed = t - start;
			const p = Math.min(elapsed / durs[current], 1);
			segs[current].style.setProperty('--p', String(p));
			if (p >= 1) {
				if (current === last) {
					setPlaying(false);
					ended = true;
					play.textContent = 'Replay';
					return;
				}
				show(current + 1);
			}
			frame = requestAnimationFrame(tick);
		};

		const setPlaying = (on: boolean) => {
			playing = on;
			play.textContent = on ? 'Pause' : 'Play';
			cancelAnimationFrame(frame);
			if (on) {
				start = performance.now() - elapsed;
				frame = requestAnimationFrame(tick);
			}
		};

		play.addEventListener('click', () => {
			touched = true;
			if (ended) show(0);
			setPlaying(!playing);
		});
		prev.addEventListener('click', () => { touched = true; show(Math.max(current - 1, 0)); });
		next.addEventListener('click', () => { touched = true; show(Math.min(current + 1, last)); });
		segs.forEach((s, i) => s.addEventListener('click', () => { touched = true; show(i); }));

		let pausedByScroll = false;
		new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) {
				if (pausedByScroll) { pausedByScroll = false; setPlaying(true); }
				else if (!touched && !reduceMotion && !ended && !playing) { touched = true; setPlaying(true); }
			} else if (playing) {
				pausedByScroll = true;
				setPlaying(false);
			}
		}, { threshold: 0.5 }).observe(fig);

		fig.classList.add('is-js');
		controls.hidden = false;
		show(0);
	}
</script>
