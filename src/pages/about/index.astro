---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Ankit Jha">
	<main class="article">
		<p class="eyebrow">About</p>
		<h1>Ankit Jha</h1>
		<p class="intro">AI Systems Engineer</p>
		<section aria-labelledby="about-placeholder-title">
			<h2 id="about-placeholder-title">Profile details</h2>
			<p>Biography, experience, and contact details will be added here.</p>
		</section>
	</main>
</BaseLayout>

<style>
	.intro { margin: -4px 0 0; color: var(--muted); font: 16px 'DM Mono', monospace; }
</style>