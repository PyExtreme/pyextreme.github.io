---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/site';
import '../../styles/prose.css';
---

<BaseLayout title="About" description={site.description}>
	<main id="main" class="listing-page">
		<PageHeader eyebrow="About" title={site.name}>
			<p>{site.role} · {site.yearsExperience} years building production AI systems.</p>
		</PageHeader>
		<div class="prose">
			<h2>Profile</h2>
			<p>Biography, experience timeline, and contact details will be added here.</p>
			<p><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true"> ↗</span></a></p>
		</div>
	</main>
</BaseLayout>
