---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StatusPill from '../../components/StatusPill.astro';
import '../../styles/prose.css';
import '../../styles/article.css';

export async function getStaticPaths() {
	const contributions = await getCollection('contributions', ({ data }) => !data.draft);
	return contributions.map((contribution) => ({ params: { slug: contribution.id }, props: { contribution } }));
}

const { contribution } = Astro.props;
const { data } = contribution;
const { Content, headings } = await render(contribution);
const words = (contribution.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const status = data.prMerged ? 'Merged' : data.status;
const date = new Date(`${data.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={data.title} description={data.description} type="article">
	<main id="main" class="article-page">
		<header class="article-header">
			<p class="eyebrow">Open source · <a href={data.repositoryUrl} target="_blank" rel="noopener noreferrer">{data.repository}</a> · {data.issueNumber}</p>
			<h1 class="display-1">{data.title}</h1>
			{data.lede && <p class="lede">{data.lede}</p>}
			<dl class="article-meta">
				<div>
					<dt>Status</dt>
					<dd><StatusPill status={status} /></dd>
				</div>
				<div>
					<dt>Date</dt>
					<dd><time datetime={data.date}>{date}</time> · {minutes} min read</dd>
				</div>
				<div>
					<dt>Area</dt>
					<dd>{data.technicalArea}</dd>
				</div>
				<div>
					<dt>Type · complexity</dt>
					<dd>{data.contributionType} · {data.complexity}</dd>
				</div>
				{data.stack.length > 0 && (
					<div>
						<dt>Stack</dt>
						<dd><ul class="chip-list">{data.stack.map((item) => <li class="chip">{item}</li>)}</ul></dd>
					</div>
				)}
				<div>
					<dt>Links</dt>
					<dd class="article-links">
						{data.issueUrl && <a href={data.issueUrl} target="_blank" rel="noopener noreferrer">Issue {data.issueNumber}<span aria-hidden="true"> ↗</span></a>}
						{data.prUrl && <a href={data.prUrl} target="_blank" rel="noopener noreferrer">Pull request<span aria-hidden="true"> ↗</span></a>}
						{data.commitUrl && <a href={data.commitUrl} target="_blank" rel="noopener noreferrer">Commit<span aria-hidden="true"> ↗</span></a>}
					</dd>
				</div>
			</dl>
		</header>
		<div class="article-layout">
			<aside class="article-aside"><TableOfContents headings={headings} /></aside>
			<div class="prose"><Content /></div>
		</div>
		<p class="backlink"><a href="/open-source/">← All open-source contributions</a></p>
	</main>
</BaseLayout>
