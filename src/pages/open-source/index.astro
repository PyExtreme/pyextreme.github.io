---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatStrip from '../../components/StatStrip.astro';
import ContributionCard from '../../components/ContributionCard.astro';

const contributions = (await getCollection('contributions', ({ data }) => !data.draft)).sort((a, b) =>
	b.data.date.localeCompare(a.data.date),
);
const merged = contributions.filter((c) => c.data.prMerged).length;
const open = contributions.filter((c) => !c.data.prMerged && c.data.status === 'PR Open').length;
const repositories = new Set(contributions.map((c) => c.data.repository)).size;
const stats = [
	{ value: contributions.length, label: 'Upstream contributions' },
	{ value: merged, label: 'Merged upstream' },
	{ value: open, label: 'Pull requests open' },
	{ value: repositories, label: 'Repositories' },
];
---

<BaseLayout title="Open source" description="Upstream contributions to vLLM, llm-d, and vLLM Router: inference lifecycle, request routing, flow control, and concurrency fixes.">
	<main id="main" class="listing-page">
		<PageHeader eyebrow="Open source" title="Upstream contributions">
			<p>Issues I picked up in open-source LLM serving infrastructure, with the root cause, the fix, and the verification for each.</p>
		</PageHeader>
		<StatStrip items={stats} />
		<section class="contributions" aria-labelledby="contributions-title">
			<div class="section-heading">
				<h2 id="contributions-title" class="display-2">Contribution log</h2>
				<form class="contribution-controls" aria-label="Filter contributions">
					<label>
						<span>Status</span>
						<select id="status-filter">
							<option value="All" selected>All</option>
							<option value="Merged">Merged</option>
							<option value="PR Open">PR open</option>
							<option value="Implementation">In progress</option>
						</select>
					</label>
					<label>
						<span>Complexity</span>
						<select id="complexity-filter">
							<option value="All" selected>All</option>
							<option value="Hard">Hard</option>
							<option value="Medium">Medium</option>
							<option value="Simple">Simple</option>
						</select>
					</label>
					<label>
						<span>Order</span>
						<select id="date-sort">
							<option value="desc" selected>Latest first</option>
							<option value="asc">Oldest first</option>
						</select>
					</label>
				</form>
			</div>
			<div class="contribution-list" id="contribution-list">
				{contributions.map((contribution) => <ContributionCard contribution={contribution} />)}
			</div>
			<p class="contribution-empty" id="contribution-empty" hidden>No contributions match these filters.</p>
		</section>
	</main>
</BaseLayout>

<style>
	.contributions { padding-top: 56px; }
	.contribution-controls { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
	.contribution-controls label { display: grid; gap: 6px; color: var(--muted); font: 500 11px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
	.contribution-controls select {
		min-width: 140px;
		padding: 9px 32px 9px 12px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		color: var(--ink);
		background: var(--paper);
		font: 500 12px var(--font-mono);
		text-transform: none;
	}
	.contribution-list { border-top: 1px solid var(--line); }
	.contribution-empty { padding: 32px 0; color: var(--muted); border-bottom: 1px solid var(--line); }
</style>

<script>
	const list = document.querySelector<HTMLElement>('#contribution-list');
	const empty = document.querySelector<HTMLElement>('#contribution-empty');
	const dateSort = document.querySelector<HTMLSelectElement>('#date-sort');
	const complexityFilter = document.querySelector<HTMLSelectElement>('#complexity-filter');
	const statusFilter = document.querySelector<HTMLSelectElement>('#status-filter');

	if (list && empty && dateSort && complexityFilter && statusFilter) {
		const cards = Array.from(list.querySelectorAll<HTMLElement>('.contribution'));

		const update = () => {
			const direction = dateSort.value === 'asc' ? 1 : -1;
			const complexity = complexityFilter.value;
			const status = statusFilter.value;
			let visible = 0;
			cards
				.sort((a, b) => direction * (a.dataset.date ?? '').localeCompare(b.dataset.date ?? ''))
				.forEach((card) => {
					const show =
						(complexity === 'All' || card.dataset.complexity === complexity) &&
						(status === 'All' || card.dataset.status === status);
					card.hidden = !show;
					if (show) visible += 1;
					list.append(card);
				});
			empty.hidden = visible > 0;
		};

		for (const control of [dateSort, complexityFilter, statusFilter]) control.addEventListener('change', update);
	}
</script>
