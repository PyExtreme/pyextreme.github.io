---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Case studies on building and operating production AI systems: market intelligence, retrieval infrastructure, and agent evaluation.">
	<main id="main" class="listing-page">
		<PageHeader eyebrow="Projects" title="Case studies">
			<p>Systems I designed and built, written up with the architecture, the trade-offs, and what the results showed.</p>
		</PageHeader>
		<div class="project-list">
			{projects.map((project, index) => (
				<ProjectCard
					number={String(index + 1).padStart(2, '0')}
					title={project.data.title}
					description={project.data.description}
					href={`/projects/${project.id}/`}
					chips={[project.data.kind, String(project.data.year), ...project.data.stack.slice(0, 3)]}
				/>
			))}
		</div>
	</main>
</BaseLayout>
