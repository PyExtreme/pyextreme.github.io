---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContributionCard from '../components/ContributionCard.astro';
import StatStrip from '../components/StatStrip.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { site, keepIdentifiers } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.listed)).sort((a, b) => a.data.order - b.data.order);
const contributions = (await getCollection('contributions', ({ data }) => !data.draft)).sort((a, b) => {
	if (a.data.prMerged !== b.data.prMerged) return a.data.prMerged ? -1 : 1;
	return b.data.date.localeCompare(a.data.date);
});
const merged = contributions.filter((c) => c.data.prMerged || c.data.status === 'Upstream Recognised').length;
const repositories = new Set(contributions.map((c) => c.data.repository)).size;
const stats = [
	{ value: '10+', label: 'Production AI systems shipped' },
	{ value: '90%', label: 'Top-setup hit rate at $4.5 per 100-symbol scan' },
	{ value: contributions.length, label: 'Upstream contributions' },
	{ value: merged, label: 'Merged upstream' },
];
const latest = contributions[0];
const latestDate = new Date(`${latest.data.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

const areas = [
	{
		title: 'Agent systems and evaluation',
		text: 'Pre-registered, equal-budget comparisons of agent architectures with deterministic replay and per-call cost accounting.',
		evidence: [{ label: 'AI Incident Commander', href: '/projects/ai-incident-commander/' }],
	},
	{
		title: 'Retrieval systems',
		text: 'Evidence-grounded RAG over SEC filings, with a pre-registered evaluation programme that rejected eleven techniques and shipped two.',
		evidence: [{ label: 'MarketLane Research', href: '/projects/marketlane-research-rag/' }],
	},
	{
		title: 'AI products in production',
		text: 'Three generations of a verified LLM scan pipeline, measured on accuracy, cost and latency, for a live market-intelligence product.',
		evidence: [{ label: 'MarketLane AI', href: '/projects/marketlane-ai/' }],
	},
	{
		title: 'LLM inference and serving',
		text: 'Startup and teardown correctness, streaming lifecycles, and resource ownership inside production inference servers.',
		evidence: [
			{ label: 'vLLM #57650', href: '/open-source/vllm-57650/' },
			{ label: 'llm-d-inference-sim #801', href: '/open-source/llm-d-inference-sim-801/' },
		],
	},
	{
		title: 'Request routing and infrastructure',
		text: 'Flow control, prefill/decode disaggregation, cache-aware routing, and admission feedback in LLM gateways.',
		evidence: [
			{ label: 'llm-d-router #2488', href: '/open-source/llm-d-router-2488/' },
			{ label: 'vLLM Router #299', href: '/open-source/vllm-router-299/' },
		],
	},
];
---

<BaseLayout>
	<main id="main" class="home">
		<section class="hero" aria-labelledby="intro-title">
			<div class="hero-intro">
				<p class="eyebrow">{site.name} · {site.role} · {site.yearsExperience} years in production AI</p>
				<h1 id="intro-title" class="hero-title">AI systems built end to end, from the agent down to the inference stack.</h1>
				<p class="hero-description">
					I design, build and operate AI products across the whole stack: agents and retrieval, the evaluation that decides
					what ships, and the serving and infrastructure underneath. Recent work: a live market-intelligence product, a
					retrieval platform over SEC filings, and upstream fixes in vLLM, llm-d and NVIDIA Dynamo.
				</p>
				<div class="btn-row">
					<a class="btn btn-primary" href="/projects/">See the work</a>
					<a class="btn" href="/open-source/">Open-source contributions</a>
					{site.email && <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>}
				</div>
				<p class="hero-employers">
					<span class="hero-employers-label">Experience</span>
					{site.employers.map((name) => <span class="hero-employer">{name}</span>)}
				</p>
			</div>
			<div class="hero-proof">
				<StatStrip items={stats} columns={2} />
				<p class="hero-highlight">
					<span class="hero-highlight-label">Latest {latest.data.prMerged ? 'merged upstream' : 'contribution'} · {latest.data.repository} {latest.data.issueNumber} · {latestDate}</span>
					<a href={`/open-source/${latest.id}/`} set:html={keepIdentifiers(latest.data.highlight ?? latest.data.title)} />
				</p>
			</div>
		</section>

		<section class="section-block" aria-labelledby="selected-work-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">01 / Case studies</p>
					<h2 id="selected-work-title" class="display-2">Selected work</h2>
				</div>
				<a class="section-link" href="/projects/">All projects →</a>
			</div>
			<div class="project-list">
				{projects.map((project, index) => (
					<ProjectCard
						number={String(index + 1).padStart(2, '0')}
						title={project.data.title}
						description={project.data.description}
						href={`/projects/${project.id}/`}
						chips={[project.data.kind, String(project.data.year), ...project.data.stack.slice(0, 2)]}
					/>
				))}
			</div>
		</section>

		<section class="section-block" aria-labelledby="open-source-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">02 / Open source</p>
					<h2 id="open-source-title" class="display-2">Upstream contributions</h2>
				</div>
				<a class="section-link" href="/open-source/">All {contributions.length} contributions across {repositories} repositories →</a>
			</div>
			<div class="contribution-list">
				{contributions.slice(0, 3).map((contribution) => <ContributionCard contribution={contribution} />)}
			</div>
		</section>

		<section class="section-block" aria-labelledby="areas-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">03 / Technical areas</p>
					<h2 id="areas-title" class="display-2">Across the stack</h2>
				</div>
			</div>
			<ul class="area-list">
				{areas.map((area) => (
					<li class="area">
						<h3>{area.title}</h3>
						<p>{area.text}</p>
						<p class="area-evidence">
							{area.evidence.map((item) => <a href={item.href}>{item.label}</a>)}
						</p>
					</li>
				))}
			</ul>
		</section>

		<ContactPanel />
	</main>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(300px, 1fr);
		gap: 48px 72px;
		align-items: center;
		padding: clamp(40px, 6vw, 72px) 0 clamp(40px, 6vw, 64px);
	}
	.hero-title {
		margin: 0 0 20px;
		font-size: clamp(32px, 4.2vw, 54px);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.hero-description { max-width: 560px; margin: 0 0 28px; color: var(--ink-soft); font-size: 17px; line-height: 1.65; text-wrap: pretty; }
	.home { padding-bottom: 96px; }
	.hero-employers { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; margin: 28px 0 0; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
	.hero-employers-label { color: var(--muted); font: 500 11px/1.5 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
	.hero-employer { color: var(--ink-soft); }
	.hero-proof { display: grid; gap: 20px; }
	.hero-highlight { display: grid; gap: 6px; margin: 0; font-size: 15px; line-height: 1.45; }
	.hero-highlight-label { color: var(--muted); font: 500 11px/1.5 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
	.hero-highlight a { color: var(--ink); font-weight: 600; text-decoration: none; }
	.hero-highlight a:hover { text-decoration: underline; text-decoration-color: var(--accent-deep); }
	.contribution-list { border-top: 1px solid var(--line); }
	.area-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 0 48px;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}
	.area { padding: 24px 0 28px; border-bottom: 1px solid var(--line); }
	.area h3 { margin: 0 0 8px; font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
	.area p { margin: 0 0 12px; color: var(--ink-soft); font-size: 15px; line-height: 1.55; }
	.area-evidence { display: flex; flex-wrap: wrap; gap: 6px 16px; font: 500 12px var(--font-mono); }
	.area-evidence a { color: var(--ink); }
	@media (max-width: 900px) {
		.hero { grid-template-columns: 1fr; gap: 36px; }
	}
	@media (max-width: 640px) {
		.hero { padding-top: 36px; }
	}
</style>
