---
import Navigation from '../components/Navigation.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Ankit Jha | AI Systems Engineer',
	description = 'Ankit Jha is an AI Systems Engineer focused on inference, serving, RAG, and distributed AI systems.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-frame">
			<Navigation />
			<slot />
			<footer class="site-footer">
				<p>AI systems, thoughtfully engineered.</p>
				<div class="footer-links">
					<a href="#" aria-label="GitHub placeholder">GitHub <span aria-hidden="true">↗</span></a>
					<a href="#" aria-label="LinkedIn placeholder">LinkedIn <span aria-hidden="true">↗</span></a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap');

	:root {
		--ink: #17211f;
		--muted: #68716e;
		--line: #d9dfdc;
		--paper: #f7f8f5;
		--accent: #d6ef62;
		--max-width: 1120px;
		font-family: 'Manrope', sans-serif;
		color: var(--ink);
		background: var(--paper);
	}

	* { box-sizing: border-box; }
	body { margin: 0; background: var(--paper); }
	a { color: inherit; }
	.site-frame { width: min(calc(100% - 48px), var(--max-width)); margin: 0 auto; }
	.site-nav { display: flex; align-items: center; justify-content: space-between; padding: 28px 0; border-bottom: 1px solid var(--line); }
	.wordmark { font-weight: 700; text-decoration: none; letter-spacing: -0.04em; }
	.nav-links, .footer-links { display: flex; flex-wrap: wrap; gap: 24px; font: 12px 'DM Mono', monospace; }
	.nav-links a, .footer-links a { text-decoration: none; }
	.nav-links a:hover, .footer-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
	main { min-height: calc(100vh - 190px); }
	.hero { padding: clamp(80px, 14vw, 168px) 0 clamp(100px, 15vw, 180px); max-width: 760px; }
	.eyebrow { margin: 0 0 20px; color: var(--muted); font: 11px 'DM Mono', monospace; letter-spacing: 0.04em; text-transform: uppercase; }
	h1, h2, p { margin-top: 0; }
	h1 { margin-bottom: 28px; font-size: clamp(58px, 9vw, 110px); line-height: 0.94; letter-spacing: -0.08em; }
	h1 em { color: var(--muted); font-style: normal; }
	.article { max-width: 760px; padding: 112px 0 160px; }
	.article h1 { max-width: 760px; }
	.article h2 { margin: 64px 0 24px; font-size: 32px; }
	.article p, .article li { max-width: 680px; color: #3f4946; font-size: 17px; line-height: 1.85; }
	.article ul, .article ol { padding-left: 24px; }
	.article code { padding: 3px 6px; background: #e9eeea; font: 0.85em 'DM Mono', monospace; }
	.article pre { overflow-x: auto; margin: 32px 0; padding: 24px; background: #1f2927; color: #edf2ec; font: 13px/1.7 'DM Mono', monospace; }
	.article pre code { padding: 0; background: transparent; color: inherit; }
	.article table { width: 100%; margin: 32px 0; border-collapse: collapse; font-size: 14px; text-align: left; }
	.article th, .article td { padding: 12px 16px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
	.article th { color: var(--ink); font-weight: 600; }
	.article td { color: var(--muted); }
	.contribution-note { max-width: 820px; }
	.article-lede { max-width: 640px; margin: -4px 0 72px; color: var(--muted); font: 15px/1.7 'DM Mono', monospace; }
	.contribution-note h2 { margin-top: 72px; }
	.contribution-note h2:first-of-type { margin-top: 0; }
	.contribution-note pre { margin: 28px 0; }
	.contribution-note strong { color: var(--ink); }
	.backlink { margin-top: 88px; font: 13px 'DM Mono', monospace; }
	.backlink a { text-underline-offset: 5px; }
	.hero-summary { margin-bottom: 20px; font: 14px 'DM Mono', monospace; line-height: 1.8; }
	.hero-description { max-width: 440px; color: var(--muted); font-size: 16px; line-height: 1.7; }
	.section-block { padding: 72px 0 112px; border-top: 1px solid var(--line); }
	.section-heading { display: grid; grid-template-columns: 1fr 2fr; margin-bottom: 48px; }
	.section-heading .eyebrow { margin: 5px 0 0; }
	h2 { margin-bottom: 0; font-size: clamp(32px, 5vw, 54px); line-height: 1; letter-spacing: -0.065em; }
	.project-list { border-top: 1px solid var(--line); }
	.project-card { display: grid; grid-template-columns: 1fr 2fr auto; gap: 24px; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
	.project-card:hover .project-title { text-decoration: underline; text-underline-offset: 5px; }
	.project-number { color: var(--muted); font: 11px 'DM Mono', monospace; }
	.project-title { margin: 0 0 6px; font-size: 20px; font-weight: 600; letter-spacing: -0.04em; }
	.project-description { margin: 0; color: var(--muted); font-size: 13px; }
	.project-arrow { font-size: 20px; }
	.area-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
	.area-list li { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 18px; letter-spacing: -0.03em; }
	.area-list li::before { content: '—'; margin-right: 14px; color: var(--muted); }
	.site-footer { display: flex; justify-content: space-between; gap: 24px; padding: 28px 0 36px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
	.site-footer p { margin: 0; }
	@media (max-width: 640px) {
		.site-frame { width: min(calc(100% - 32px), var(--max-width)); }
		.site-nav { padding: 20px 0; }
		.nav-links { gap: 14px; font-size: 10px; }
		.nav-links { justify-content: flex-end; }
		.hero { padding-top: 90px; }
		.section-heading { display: block; }
		.section-heading .eyebrow { margin-bottom: 20px; }
		.project-card { grid-template-columns: 42px 1fr 20px; gap: 12px; }
		.project-title { font-size: 17px; }
		.area-list { grid-template-columns: 1fr; }
		.site-footer { display: block; }
		.footer-links { margin-top: 20px; }
		.article { padding: 80px 0 110px; }
		.article h2 { font-size: 28px; }
		.article p, .article li { font-size: 16px; }
		.article table { display: block; overflow-x: auto; white-space: nowrap; }
		.article-lede { margin-bottom: 56px; font-size: 13px; }
		.contribution-note h2 { margin-top: 56px; }
		.contribution-note table { font-size: 12px; }
	}
</style>